DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional in local development; required for persistent product images after deployment.
# Use the Project URL and a server-only secret key from Supabase Settings → API Keys.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
